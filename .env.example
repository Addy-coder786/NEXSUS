# Used by `docker compose up` (root docker-compose.yml). For `npm run dev`, use apps/api/.env.

# Public URL of the web container (the API is proxied under /api on the same origin).
PUBLIC_URL=http://localhost:8080

# Required. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional integrations (features stay off when empty)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="NEXUS <noreply@example.com>"
CLOUDINARY_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Enables GET /api/metrics (send "Authorization: Bearer <token>"); 16+ chars
METRICS_TOKEN=
# Error reporting to Sentry (optional)
SENTRY_DSN=
