{
  "display_information": {
    "name": "NEXUS",
    "description": "Team operating system: tasks, chat, docs and AI connected to Slack",
    "background_color": "#111827"
  },
  "features": {
    "bot_user": {
      "display_name": "NEXUS",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:4000/api/auth/slack/callback",
      "http://localhost:4000/api/integrations/slack/callback"
    ],
    "scopes": {
      "user": ["openid", "email", "profile"],
      "bot": [
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:read",
        "team:read",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
