# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Database (local Mongo or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/nexus

# Optional: Redis (permission cache, rate limiting). Falls back to in-memory if unset.
# REDIS_URL=redis://localhost:6379

# Auth: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
# COOKIE_DOMAIN=localhost

# Email (Resend). If unset, emails are logged to the console.
# RESEND_API_KEY=re_xxx
EMAIL_FROM="NEXUS <noreply@example.com>"

# OAuth (optional; the provider button is hidden when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# File storage (Cloudinary). If unset, files are stored on local disk under ./uploads
# CLOUDINARY_URL=cloudinary://key:secret@cloud

# --- Phase 2 ---
# Slack integration (workspace connect, channel sync, outbound notifications).
# Needs all three; the Events API also needs a public HTTPS URL (ngrok in dev) pointing to
# ${API_URL}/api/integrations/slack/events
# SLACK_SIGNING_SECRET=

# Encrypts stored integration tokens. Required in production (64 hex chars):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Per-workspace file storage quota in bytes (default 5 GiB)
# STORAGE_LIMIT_BYTES=5368709120

# --- Phase 3: AI ---
# Claude API key. Enables the assistant, task generation, meeting notes, summaries and insights.
# (AI_ENABLED=true enables AI with credentials from an `ant auth login` profile instead.)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5
# Per-workspace AI requests per day (default 500)
# AI_DAILY_LIMIT=500

# Voyage AI embeddings for semantic search (keyword search is used without it)
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5
# local (default): in-process cosine similarity; atlas: $vectorSearch on index nexus_chunks_vector
# VECTOR_SEARCH=local

# --- Production ---
# Enables GET /api/metrics with "Authorization: Bearer <token>" (16+ chars)
# METRICS_TOKEN=
# LOG_LEVEL=info
